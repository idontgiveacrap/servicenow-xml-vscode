{
  "name": "servicenow-xml",
  "displayName": "ServiceNow XML",
  "description": "Colorize and lint embedded ServiceNow scripts in exported XML; kind-aware XML structure validation; optional Records navigator.",
  "version": "2.2.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:xml",
    "onView:servicenowXml.records",
    "onCommand:servicenowXml.goToRecord",
    "onCommand:servicenowXml.navigator.enable",
    "onCommand:servicenowXml.navigator.refresh"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "servicenowXml.showKind",
        "title": "ServiceNow XML: Show Document Kind"
      },
      {
        "command": "servicenowXml.revalidate",
        "title": "ServiceNow XML: Revalidate Active Document"
      },
      {
        "command": "servicenowXml.goToRecord",
        "title": "ServiceNow XML: Go to Record"
      },
      {
        "command": "servicenowXml.navigator.enable",
        "title": "ServiceNow XML: Enable Records Navigator"
      },
      {
        "command": "servicenowXml.navigator.refresh",
        "title": "ServiceNow XML: Refresh Records Navigator",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "servicenow-xml",
          "title": "ServiceNow",
          "icon": "media/servicenow.svg"
        }
      ]
    },
    "views": {
      "servicenow-xml": [
        {
          "id": "servicenowXml.records",
          "name": "Records",
          "contextualTitle": "ServiceNow Records"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "servicenowXml.navigator.refresh",
          "when": "view == servicenowXml.records",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "ServiceNow XML",
      "properties": {
        "servicenowXml.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable ServiceNow XML validation and JS linting."
        },
        "servicenowXml.lintJavaScript": {
          "type": "boolean",
          "default": true,
          "description": "Lint embedded JavaScript in script CDATA regions."
        },
        "servicenowXml.lintJson": {
          "type": "boolean",
          "default": true,
          "description": "Lint JSON embedded in known ServiceNow XML fields."
        },
        "servicenowXml.ignoreGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/author_elective_update/**"
          ],
          "description": "Glob patterns for XML paths to skip (validation, lint, and navigator)."
        },
        "servicenowXml.debounceMs": {
          "type": "number",
          "default": 400,
          "description": "Debounce delay (ms) before re-validating on edit."
        },
        "servicenowXml.navigator.enable": {
          "type": "boolean",
          "default": false,
          "description": "Enable the ServiceNow Records navigator. No indexing runs until the view is opened or Go to Record is used."
        },
        "servicenowXml.navigator.includeDelete": {
          "type": "boolean",
          "default": false,
          "description": "Include action=DELETE records in the navigator."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "servicenow-xml.injection",
        "path": "./syntaxes/servicenow-xml.injection.tmLanguage.json",
        "injectTo": [
          "text.xml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.javascript": "javascript",
          "source.js": "javascript"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository",
    "compile": "npm run build",
    "test": "node scripts/smoke-record-name.js && tsc --noEmit"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "eslint": "^8.57.1",
    "fast-xml-parser": "^5.10.1",
    "minimatch": "^9.0.5"
  }
}
