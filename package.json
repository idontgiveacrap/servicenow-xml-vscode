{
  "name": "servicenow-xml",
  "displayName": "ServiceNow XML",
  "description": "Colorize and lint embedded ServiceNow scripts in exported XML; kind-aware XML structure validation; optional Records navigator.",
  "version": "2.2.3",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:xml",
    "onView:servicenowXml.records",
    "onCommand:servicenowXml.goToRecord",
    "onCommand:servicenowXml.navigator.enable",
    "onCommand:servicenowXml.navigator.refresh",
    "onCommand:servicenowXml.navigator.sortBy",
    "onCommand:servicenowXml.navigator.filter",
    "onCommand:servicenowXml.navigator.clearFilter",
    "onCommand:servicenowXml.revealInExplorer",
    "onCommand:servicenowXml.revealInFileExplorer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "servicenowXml.showKind",
        "title": "ServiceNow XML: Show Document Kind"
      },
      {
        "command": "servicenowXml.revalidate",
        "title": "ServiceNow XML: Revalidate Active Document"
      },
      {
        "command": "servicenowXml.goToRecord",
        "title": "ServiceNow XML: Go to Record"
      },
      {
        "command": "servicenowXml.navigator.enable",
        "title": "ServiceNow XML: Enable Records Navigator"
      },
      {
        "command": "servicenowXml.navigator.refresh",
        "title": "ServiceNow XML: Refresh Records Navigator",
        "icon": "$(refresh)"
      },
      {
        "command": "servicenowXml.navigator.sortBy",
        "title": "ServiceNow XML: Sort Records By…",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "servicenowXml.navigator.filter",
        "title": "ServiceNow XML: Filter Records…",
        "icon": "$(filter)"
      },
      {
        "command": "servicenowXml.navigator.clearFilter",
        "title": "ServiceNow XML: Clear Records Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "servicenowXml.revealInExplorer",
        "title": "Reveal in Explorer"
      },
      {
        "command": "servicenowXml.revealInFileExplorer",
        "title": "Reveal in File Explorer"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "servicenow-xml",
          "title": "ServiceNow",
          "icon": "media/servicenow.svg"
        }
      ]
    },
    "views": {
      "servicenow-xml": [
        {
          "id": "servicenowXml.records",
          "name": "Records",
          "contextualTitle": "ServiceNow Records",
          "when": "servicenowXml.isSnWorkspace || config.servicenowXml.enabledForAllWindows"
        }
      ]
    },
    "viewsWelcome": {
      "servicenowXml.records": [
        {
          "contents": "Enable the navigator to browse ServiceNow records by name.\n[Enable Records Navigator](command:servicenowXml.navigator.enable)",
          "when": "!config.servicenowXml.navigator.enable"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "servicenowXml.navigator.filter",
          "when": "view == servicenowXml.records",
          "group": "navigation@1"
        },
        {
          "command": "servicenowXml.navigator.clearFilter",
          "when": "view == servicenowXml.records && servicenowXml.recordsFiltered",
          "group": "navigation@2"
        },
        {
          "command": "servicenowXml.navigator.sortBy",
          "when": "view == servicenowXml.records",
          "group": "navigation@3"
        },
        {
          "command": "servicenowXml.navigator.refresh",
          "when": "view == servicenowXml.records",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "servicenowXml.revealInExplorer",
          "when": "view == servicenowXml.records && viewItem == servicenowXml.record",
          "group": "navigation@1"
        },
        {
          "command": "servicenowXml.revealInFileExplorer",
          "when": "view == servicenowXml.records && viewItem == servicenowXml.record",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "ServiceNow XML",
      "properties": {
        "servicenowXml.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable ServiceNow XML validation and JS linting when the workspace gate passes (or enabledForAllWindows is on)."
        },
        "servicenowXml.enabledForAllWindows": {
          "type": "boolean",
          "default": false,
          "description": "Bypass the ServiceNow app workspace gate so diagnostics run in any window (including single-file / non-project windows) and the Records navigator stays visible."
        },
        "servicenowXml.lintJavaScript": {
          "type": "boolean",
          "default": true,
          "description": "Lint embedded JavaScript in script CDATA regions."
        },
        "servicenowXml.lintJson": {
          "type": "boolean",
          "default": true,
          "description": "Lint JSON embedded in known ServiceNow XML fields."
        },
        "servicenowXml.ignoreGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/author_elective_update/**"
          ],
          "description": "Glob patterns for XML paths to skip (validation, lint, and navigator)."
        },
        "servicenowXml.debounceMs": {
          "type": "number",
          "default": 400,
          "description": "Debounce delay (ms) before re-validating on edit."
        },
        "servicenowXml.navigator.enable": {
          "type": "boolean",
          "default": false,
          "description": "Enable the ServiceNow Records navigator. No indexing runs until the view is opened or Go to Record is used."
        },
        "servicenowXml.navigator.excludeDelete": {
          "type": "boolean",
          "default": false,
          "description": "Hide action=DELETE records from the navigator."
        },
        "servicenowXml.navigator.sortBy": {
          "type": "string",
          "default": "mostOpened",
          "enum": [
            "mostOpened",
            "recentlyOpened",
            "recentlyUpdated",
            "sysModCount",
            "name"
          ],
          "enumDescriptions": [
            "Most opened (open count; table order by sum of opens)",
            "Recently opened (last open time; table order by most recent child)",
            "Recently updated (file mtime; table order by newest child)",
            "sys_mod_count (ServiceNow update count; table order by max child)",
            "Alphabetical by table then display name"
          ],
          "description": "Sort order for Records navigator tables and records."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "servicenow-xml.injection",
        "path": "./syntaxes/servicenow-xml.injection.tmLanguage.json",
        "injectTo": [
          "text.xml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.javascript": "javascript",
          "source.js": "javascript"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository",
    "compile": "npm run build",
    "test": "node scripts/smoke-record-name.js && tsc --noEmit"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "eslint": "^8.57.1",
    "fast-xml-parser": "^5.10.1",
    "minimatch": "^9.0.5"
  }
}
